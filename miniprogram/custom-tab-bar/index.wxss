.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 48px;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #fffaf5;
  border-top: 1px solid rgba(240, 228, 216, 0.9);
  z-index: 9999;
  box-sizing: content-box;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 12px;
  color: #a89888;
  line-height: 48px;
}

.tab-item.on {
  color: #e8917a;
  font-weight: 600;
}
