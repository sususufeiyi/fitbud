.hero {
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-muted);
}

.filters {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  margin: 8rpx 0 20rpx;
  padding-bottom: 4rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  color: var(--color-ink);
  background: #fff;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(92, 70, 56, 0.06);
}

.filter-chip.on {
  background: var(--color-accent);
  color: #fff;
  font-weight: 600;
}

.filter-count {
  margin-left: 8rpx;
  min-width: 28rpx;
  padding: 0 8rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 18rpx;
  border-radius: 999rpx;
  background: rgba(92, 70, 56, 0.08);
  color: inherit;
}

.filter-chip.on .filter-count {
  background: rgba(255, 255, 255, 0.28);
}

.tip {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #9a6b2f;
  word-break: break-all;
}

.tip.muted {
  color: var(--color-muted);
}

.card {
  margin-bottom: 16rpx;
  padding: 28rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
}

.status {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
}

.status.pending {
  background: #fff0d6;
  color: #9a6b2f;
}

.status.approved {
  background: var(--color-mint);
  color: #3d6b52;
}

.status.rejected {
  background: #ffe0e0;
  color: #c45c5c;
}

.status.redeemed,
.status.bought {
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

.meta,
.meta2 {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.need {
  color: var(--color-accent);
  font-weight: 600;
}

.tags {
  margin-top: 12rpx;
}

.tag {
  display: inline-block;
  margin-right: 8rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  background: #f3ebe3;
  color: #8a7364;
  border-radius: 999rpx;
}

.tag.lux {
  background: #f3e8ff;
  color: #8b5bb0;
}

.redeem-bar {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: 24rpx;
}

.redeem-bar.ok {
  background: #fff0ea;
}

.redeem-bar.short {
  background: #f5efe9;
}

.redeem-bar:active {
  opacity: 0.88;
}

.redeem-info {
  flex: 1;
  min-width: 0;
}

.redeem-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.redeem-ratio {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.redeem-ratio .mine {
  font-weight: 700;
  color: var(--color-accent);
  font-size: 26rpx;
}

.redeem-bar.short .mine {
  color: #a89888;
}

.redeem-ratio .need-pts {
  font-weight: 600;
  color: var(--color-ink);
}

.redeem-ratio .hint {
  color: var(--color-muted);
}

.redeem-action {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: var(--color-accent);
  border-radius: 999rpx;
}

.redeem-action.off {
  background: #ddd2c8;
  color: #9a8b7c;
}

.buy-bar {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: 24rpx;
  background: #e8f5ee;
}

.buy-bar:active {
  opacity: 0.88;
}

.buy-info {
  flex: 1;
  min-width: 0;
}

.buy-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.buy-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.buy-action {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  background: #5a9e78;
  border-radius: 999rpx;
}

.empty {
  padding: 64rpx 0;
  text-align: center;
  color: var(--color-muted);
  font-size: 26rpx;
}

.fab {
  margin-top: 28rpx;
  background: var(--color-accent) !important;
  color: #fff !important;
  border-radius: 999rpx !important;
}
