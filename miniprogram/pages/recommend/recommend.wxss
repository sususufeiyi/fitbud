.hero {
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-muted);
}

.tip {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #9a6b2f;
  word-break: break-all;
}

.tip.muted {
  color: var(--color-muted);
}

.card {
  margin-bottom: 16rpx;
  padding: 28rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
}

.status {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
}

.status.pending {
  background: #fff0d6;
  color: #9a6b2f;
}

.status.approved {
  background: var(--color-mint);
  color: #3d6b52;
}

.status.rejected {
  background: #ffe0e0;
  color: #c45c5c;
}

.meta,
.meta2 {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.need {
  color: var(--color-accent);
  font-weight: 600;
}

.tags {
  margin-top: 12rpx;
}

.tag {
  display: inline-block;
  margin-right: 8rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  background: #f3ebe3;
  color: #8a7364;
  border-radius: 999rpx;
}

.tag.lux {
  background: #f3e8ff;
  color: #8b5bb0;
}

.empty {
  padding: 64rpx 0;
  text-align: center;
  color: var(--color-muted);
  font-size: 26rpx;
}

.fab {
  margin-top: 28rpx;
  background: var(--color-accent) !important;
  color: #fff !important;
  border-radius: 999rpx !important;
}
