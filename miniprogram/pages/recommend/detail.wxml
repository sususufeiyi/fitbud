<view class="page" wx:if="{{item}}">
  <view class="head">
    <view class="title">{{item.name}}</view>
    <view class="status {{item.status}}">{{item.statusText}}</view>
  </view>
  <view class="sub">{{item.authorName}} 想说 · {{item.brand || '暂无补充'}} · {{item.category}}</view>

  <view class="block">
    <view class="row"><text class="k">大概花费</text><text class="v">¥{{item.price}}</text></view>
    <view class="row">
      <text class="k">{{item.unitLabel}}</text>
      <text class="v">¥{{item.unitPrice}}（{{item.usageCount}}{{item.usageUnit === 'times' ? '次' : '天'}}）</text>
    </view>
    <view class="row" wx:if="{{item.isExpensive || item.isLuxury}}">
      <text class="k">自我感觉</text>
      <text class="v">
        <text wx:if="{{item.isExpensive}}">有点贵 </text>
        <text wx:if="{{item.isLuxury}}">有点奢</text>
      </text>
    </view>
  </view>

  <view class="block" wx:if="{{item.manifesto}}">
    <view class="block-title">原因</view>
    <view class="manifesto">{{item.manifesto}}</view>
  </view>

  <view class="photos" wx:if="{{item.photos && item.photos.length}}">
    <image
      wx:for="{{item.photos}}"
      wx:for-item="photo"
      wx:key="*this"
      src="{{photo}}"
      mode="aspectFill"
      data-url="{{photo}}"
      bindtap="preview"
    />
  </view>

  <view class="block">
    <view class="block-title">朋友们怎么说</view>
    <view class="vote" wx:for="{{item.votes}}" wx:for-item="vote" wx:key="openid">
      <view class="vote-top">
        <text>{{vote.name}}</text>
        <text class="{{vote.pass ? 'ok' : 'no'}}">{{vote.pass ? '支持' : '再想想'}}</text>
      </view>
      <view class="vote-reason">{{vote.reason}}</view>
    </view>
    <view class="pending" wx:for="{{item.pendingVoters}}" wx:for-item="pv" wx:key="openid">
      {{pv.name}} · 还没看
    </view>
    <view class="empty" wx:if="{{!item.votes.length && !item.pendingVoters.length}}">
      群里暂时只有你，默认可以去做
    </view>
  </view>

  <view class="block vote-box" wx:if="{{item.canVote}}">
    <view class="block-title">你怎么看</view>
    <view class="unit-row">
      <view class="unit {{pass ? 'on' : ''}}" bindtap="setPass">支持</view>
      <view class="unit {{!pass ? 'on reject' : ''}}" bindtap="setReject">再想想</view>
    </view>
    <view class="preset-label">{{pass ? '随口一句（可改）' : '直说无妨（可改）'}}</view>
    <view class="preset-row">
      <view
        class="preset-chip {{reason === item ? 'on' : ''}}"
        wx:for="{{pass ? passPresets : roastPresets}}"
        wx:key="*this"
        data-text="{{item}}"
        bindtap="pickPreset"
      >{{item}}</view>
    </view>
    <textarea
      class="textarea"
      placeholder="写两句你的想法（必填）"
      value="{{reason}}"
      bindinput="onReason"
      maxlength="300"
    />
    <button class="btn" loading="{{voting}}" bindtap="submitVote">告诉 TA</button>
  </view>

  <view class="hint" wx:if="{{item.isAuthor && item.status === 'pending'}}">
    你是发起人，等朋友们回你就好
  </view>
  <view class="hint" wx:if="{{item.myVote}}">
    你已回复：{{item.myVote.pass ? '支持' : '再想想'}}
  </view>

  <button
    class="del-btn"
    wx:if="{{item.isAuthor}}"
    loading="{{deleting}}"
    bindtap="deleteItem"
  >删掉这条</button>
</view>

<view class="page" wx:else>
  <view class="tip">{{tip || '加载中…'}}</view>
</view>
