<view class="page">
  <view class="hero-tip">今天想干什么？随便说说就好</view>

  <view class="label">想做的事 *</view>
  <input class="input" placeholder="例如：想吃火鸡面" value="{{name}}" bindinput="onName" maxlength="40" />

  <view class="label">补充一下（选填）</view>
  <input class="input" placeholder="品牌 / 店名 / 地点都行" value="{{brand}}" bindinput="onBrand" maxlength="40" />

  <view class="label">大致类型 *</view>
  <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory">
    <view class="input picker">{{categories[categoryIndex]}}</view>
  </picker>

  <view class="label">大概花费（元）*</view>
  <input class="input" type="digit" placeholder="例如：15" value="{{price}}" bindinput="onPrice" />

  <view class="label">打算用多久 / 几次 *</view>
  <view class="unit-row">
    <view class="unit {{usageUnit === 'days' ? 'on' : ''}}" bindtap="onUnitDays">按天数</view>
    <view class="unit {{usageUnit === 'times' ? 'on' : ''}}" bindtap="onUnitTimes">按次数</view>
  </view>
  <input
    class="input"
    type="number"
    placeholder="{{usageUnit === 'times' ? '大概几次' : '大概几天'}}"
    value="{{usageCount}}"
    bindinput="onUsage"
  />
  <view class="calc">自动估算：{{unitPriceText}}</view>

  <view class="check-row" bindtap="toggleExpensive">
    <view class="box {{isExpensive ? 'on' : ''}}">{{isExpensive ? '✓' : ''}}</view>
    <view class="check-text">有点小贵（我觉得偏高）</view>
  </view>
  <view class="check-row" bindtap="toggleLuxury">
    <view class="box {{isLuxury ? 'on' : ''}}">{{isLuxury ? '✓' : ''}}</view>
    <view class="check-text">有点奢侈（同类型里偏贵）</view>
  </view>

  <view class="label">原因 *</view>
  <textarea
    class="textarea"
    placeholder="例如：已经很久没有吃过火鸡面了"
    value="{{manifesto}}"
    bindinput="onManifesto"
    maxlength="1000"
  />

  <view class="label">照片（选填）</view>
  <view class="photos">
    <view class="photo" wx:for="{{photos}}" wx:key="*this">
      <image src="{{item}}" mode="aspectFill" />
      <view class="del" data-index="{{index}}" catchtap="removePhoto">×</view>
    </view>
    <view class="photo add" bindtap="choosePhotos">＋</view>
  </view>

  <button class="btn" type="primary" loading="{{submitting}}" bindtap="submit">告诉朋友们</button>
</view>
