<view class="page">
  <view class="label">物品名 *</view>
  <input class="input" placeholder="例如：降噪耳机" value="{{name}}" bindinput="onName" maxlength="40" />

  <view class="label">品牌</view>
  <input class="input" placeholder="例如：Sony" value="{{brand}}" bindinput="onBrand" maxlength="40" />

  <view class="label">种类 *</view>
  <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory">
    <view class="input picker">{{categories[categoryIndex]}}</view>
  </picker>

  <view class="label">价格（元）*</view>
  <input class="input" type="digit" placeholder="例如：899" value="{{price}}" bindinput="onPrice" />

  <view class="label">使用周期 / 次数 *</view>
  <view class="unit-row">
    <view class="unit {{usageUnit === 'days' ? 'on' : ''}}" bindtap="onUnitDays">按天数</view>
    <view class="unit {{usageUnit === 'times' ? 'on' : ''}}" bindtap="onUnitTimes">按次数</view>
  </view>
  <input
    class="input"
    type="number"
    placeholder="{{usageUnit === 'times' ? '预计使用多少次' : '预计用多少天'}}"
    value="{{usageCount}}"
    bindinput="onUsage"
  />
  <view class="calc">自动计算：{{unitPriceText}}</view>

  <view class="check-row" bindtap="toggleExpensive">
    <view class="box {{isExpensive ? 'on' : ''}}">{{isExpensive ? '✓' : ''}}</view>
    <view class="check-text">贵价（我认为价格偏高，如大于 500）</view>
  </view>
  <view class="check-row" bindtap="toggleLuxury">
    <view class="box {{isLuxury ? 'on' : ''}}">{{isLuxury ? '✓' : ''}}</view>
    <view class="check-text">奢侈（同类型很贵，或大于 1000）</view>
  </view>

  <view class="label">种草宣言</view>
  <textarea
    class="textarea"
    placeholder="为什么想买？能解决什么问题？"
    value="{{manifesto}}"
    bindinput="onManifesto"
    maxlength="1000"
  />

  <view class="label">照片（选填）</view>
  <view class="photos">
    <view class="photo" wx:for="{{photos}}" wx:key="*this">
      <image src="{{item}}" mode="aspectFill" />
      <view class="del" data-index="{{index}}" catchtap="removePhoto">×</view>
    </view>
    <view class="photo add" bindtap="choosePhotos">＋</view>
  </view>

  <button class="btn" type="primary" loading="{{submitting}}" bindtap="submit">提交群审</button>
</view>
