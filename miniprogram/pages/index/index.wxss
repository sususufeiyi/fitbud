.tip {
  margin-top: 20rpx;
  padding: 18rpx 24rpx;
  background: #fff0d6;
  color: #9a6b2f;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  word-break: break-all;
}

.card {
  margin-top: 28rpx;
  padding: 32rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.card-label {
  font-size: 24rpx;
  color: var(--color-muted);
}

.card-title {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.card-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-muted);
}

.invite-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.invite-code {
  font-size: 28rpx;
  color: var(--color-ink);
  letter-spacing: 0.06em;
}

.link {
  font-size: 26rpx;
  color: var(--color-accent);
}

.share-btn {
  margin-top: 20rpx;
  background: var(--color-accent) !important;
  color: #fff !important;
  border-radius: 999rpx !important;
}

.actions {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.action {
  flex: 1;
  font-size: 26rpx;
  background: var(--color-accent-soft) !important;
  color: var(--color-ink) !important;
  border-radius: 999rpx !important;
}

.section-title {
  margin: 40rpx 0 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.group-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx;
  margin-bottom: 14rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  border: 3rpx solid transparent;
}

.group-item.active {
  border-color: var(--color-accent);
  background: #fff8f4;
}

.group-main {
  flex: 1;
  min-width: 0;
}

.group-name {
  font-size: 30rpx;
  font-weight: 600;
}

.group-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.enter-btn {
  flex-shrink: 0;
  background: var(--color-accent) !important;
  color: #fff !important;
  border-radius: 999rpx !important;
}

.enter-btn.on {
  background: var(--color-mint) !important;
  color: var(--color-ink) !important;
}

.list-loading,
.empty-list {
  padding: 24rpx 0;
  font-size: 26rpx;
  color: var(--color-muted);
}

.member-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 14rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.member-left {
  flex: 1;
  min-width: 0;
}

.member-name {
  font-size: 30rpx;
  font-weight: 600;
}

.me-tag,
.role-tag {
  margin-left: 10rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  font-weight: 500;
  border-radius: 999rpx;
  vertical-align: middle;
}

.me-tag {
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

.role-tag {
  background: #f3ebe3;
  color: var(--color-muted);
}

.member-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.member-right {
  text-align: right;
  flex-shrink: 0;
}

.member-stat {
  font-size: 24rpx;
  color: var(--color-muted);
}

.member-points {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-accent);
}

.form .input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 0 24rpx;
  line-height: normal;
  background: #fff8f2;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  border: 2rpx solid var(--color-line);
}

.btn {
  background: var(--color-accent) !important;
  color: #fff !important;
  border-radius: 999rpx !important;
}

.btn.ghost {
  margin-top: 12rpx;
  background: var(--color-accent-soft) !important;
  color: var(--color-ink) !important;
}

.divider {
  margin: 36rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-muted);
}

.action-main {
  margin-top: 16rpx;
  background: var(--color-mint) !important;
  color: var(--color-ink) !important;
  border-radius: 999rpx !important;
}

.profile-card .profile-now {
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: var(--color-muted);
}

.profile-label {
  margin: 8rpx 0 10rpx;
  font-size: 24rpx;
  color: var(--color-ink);
  font-weight: 600;
}
