<view class="page">
  <view class="hero-title">坚持奖励</view>
  <view class="hero-sub">{{groupName || '未选择群组'}} · 连续打卡解锁</view>

  <block wx:if="{{!locked}}">
    <view class="stats">
      <view class="stat">
        <view class="stat-num">{{streak}}</view>
        <view class="stat-label">连续</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{totalCheckins}}</view>
        <view class="stat-label">总打卡</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{points}}</view>
        <view class="stat-label">积分</view>
      </view>
    </view>

    <view class="list">
      <view class="item" wx:for="{{milestones}}" wx:key="days">
        <view class="item-main">
          <view class="item-title">{{item.title}}</view>
          <view class="item-sub">连续 {{item.days}} 天 · +{{item.points}} 分</view>
        </view>
        <button
          class="claim"
          size="mini"
          disabled="{{!item.unlocked || item.claimed}}"
          data-days="{{item.days}}"
          bindtap="claim"
        >
          {{item.claimed ? '已领' : (item.unlocked ? '领取' : '未解锁')}}
        </button>
      </view>
    </view>
  </block>
</view>
